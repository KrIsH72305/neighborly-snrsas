# Supabase Configuration
# Replace these with your actual Supabase project credentials from Project Settings -> API
# Note: For Vite, client-side environment variables must be prefixed with VITE_

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# IMPORTANT:
# - Never commit your secret service_role key to frontend code!
# - If these keys are not set or left as placeholders, Neighborly automatically runs in rich Demo Mode (using localStorage).
